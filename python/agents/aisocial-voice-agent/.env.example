# AISocial Voice Agent - Environment Variables
# Copy this file to .env and fill in the values.

# Google Cloud / Gemini API Key
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Cloud Project (optional, for Vertex AI deployment)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Webhook URL for sending lead data to external CRM/backend
# Leave empty to skip webhook calls
AISOCIAL_WEBHOOK_URL=

# Owner notification channel: log, email, sms, whatsapp
AISOCIAL_NOTIFY_CHANNEL=log

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
